# Prisma / PostgreSQL (compose.yaml maps host 127.0.0.1:55432 → container 5432)
DATABASE_URL="postgresql://qc_app:qc_app@localhost:55432/qc_app?schema=public"

# Public origin for auth callbacks and absolute links
QC_PUBLIC_ORIGIN="http://localhost:3000"
QC_PUBLIC_ORIGIN_ALLOWLIST="localhost:3000"

# Required in production (no defaults). Local/dev may omit QC_SECRET_KEY / AUTH_SECRET
# and use in-code non-production fallbacks — never rely on those outside your laptop.
# AUTH_SECRET=
# QC_SECRET_KEY=

# Local-only — NEVER set in production (boot refuses QC_DEMO_AUTH=enabled)
# QC_DEMO_AUTH=enabled

# Local/on-prem escape hatch — NEVER enable on shared SaaS (disables SSRF IP checks)
# QC_ALLOW_PRIVATE_BASE_URLS=1

# Seed is refused when NODE_ENV=production; ALLOW_SEED only for non-prod host overrides
# ALLOW_SEED=1

# Optional gated live smoke — never commit real credentials; never against prod
# OTRS_LIVE_SMOKE=1
# OTRS_BASE_URL=
# OTRS_USER_LOGIN=
# OTRS_PASSWORD=
# DATA_SOURCE_LIVE_SMOKE=1
# DATA_SOURCE_LIVE_SOURCE=ydb
# DATA_SOURCE_LIVE_BASE_URL=
# DATA_SOURCE_LIVE_CREDENTIAL=
# DATA_SOURCE_LIVE_YDB_QUERY=SELECT 1 AS n
# DATA_SOURCE_LIVE_CONNECTIVITY_ONLY=1
