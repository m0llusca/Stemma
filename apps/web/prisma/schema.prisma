generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  TEAM_LEAD
  QA_ANALYST
  SUPPORT_AGENT
  VIEWER
}

enum QaStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  FINALIZED
  REOPENED
}

enum ConversationChannel {
  CHAT
  EMAIL
  TICKET
  MESSENGER
}

enum ParticipantType {
  CUSTOMER
  HUMAN_AGENT
  AI_AGENT
  SYSTEM
}

enum ReviewSource {
  HUMAN
  AI
  CALIBRATION
  SELF_REVIEW
}

enum ReviewStatus {
  DRAFT
  FINALIZED
}

enum CriterionKind {
  SCALE_1_3
  PASS_FAIL
}

enum FindingOwnerType {
  AGENT
  PROCESS
  PRODUCT
  POLICY
  AI_SYSTEM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  integrations  Integration[]
  integrationRuns IntegrationRun[]
  apiTokens     ApiToken[]
  conversations Conversation[]
  scorecards    Scorecard[]
  reviews       Review[]
  reviewQuotas  ReviewQuota[]
  savedQueueViews SavedQueueView[]
  calibrationSessions CalibrationSession[]
  samplingRules SamplingRule[]
  knowledgeEntries QualityKnowledgeEntry[]
  trainingAssignments TrainingAssignment[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  email       String
  name        String
  role        RoleName
  supportLine String?
  teamName    String?
  reviews     Review[]
  savedQueueViews SavedQueueView[]
  ownedCalibrationSessions CalibrationSession[] @relation("CalibrationOwner")
  calibrationParticipants CalibrationParticipant[]
  feedbackEvents ReviewFeedbackEvent[]
  assignedTrainingAssignments TrainingAssignment[] @relation("TrainingAssignee")
  createdTrainingAssignments TrainingAssignment[] @relation("TrainingAssignedBy")
  integrationRuns IntegrationRun[]
  auditLogs   AuditLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, email])
}

model Integration {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  source       String
  displayName  String
  type         String    @default("custom_api")
  status       String
  baseUrl      String?
  configJson   String    @default("{}")
  authMode     String    @default("token")
  importLimit  Int       @default(100)
  batchSize    Int       @default(25)
  dateRangeDays Int      @default(30)
  schedule     String?
  syncCursor   String?
  lastSyncedAt DateTime?
  lastDryRunAt DateTime?
  lastImportAt DateTime?
  lastError    String?
  runs         IntegrationRun[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, source])
}

model ApiToken {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  tokenPrefix  String
  tokenHash    String    @unique
  scopes       String
  lastUsedAt   DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
}

model Conversation {
  id             String              @id @default(cuid())
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id])
  externalSource String
  externalId     String
  externalUrl    String?
  channel        ConversationChannel
  subject        String
  status         String
  tags           String
  customerName   String
  assigneeName   String?
  qaStatus       QaStatus            @default(QUEUED)
  qaAssigneeId   String?
  qaAssigneeName String?
  reviewDueAt    DateTime?
  samplingReason String
  samplingType   String              @default("RANDOM")
  csatScore      Int?
  csatBucket     String              @default("NO_SCORE")
  supportLine    String?
  teamName       String?
  riskHint       String?
  openedAt       DateTime
  closedAt       DateTime?
  messages       Message[]
  reviews        Review[]
  calibrationItems CalibrationSessionItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([workspaceId, externalSource, externalId])
  @@index([workspaceId, qaStatus])
}

model Message {
  id              String          @id @default(cuid())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id])
  externalId      String
  participantType ParticipantType
  authorName      String
  body            String
  sentAt          DateTime
  isPrivate       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([conversationId, externalId])
}

model Scorecard {
  id          String               @id @default(cuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  name        String
  version     Int
  isActive    Boolean              @default(true)
  criteria    ScorecardCriterion[]
  reviews     Review[]
  calibrationSessions CalibrationSession[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ScorecardCriterion {
  id          String           @id @default(cuid())
  scorecardId String
  scorecard   Scorecard        @relation(fields: [scorecardId], references: [id])
  key         String
  label       String
  block       String           @default("Общее")
  kind        CriterionKind
  weight      Int
  required    Boolean          @default(true)
  order       Int
  scores      CriterionScore[]

  @@unique([scorecardId, key])
  @@unique([scorecardId, order])
}

model Review {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id])
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  reviewerId     String
  reviewer       User             @relation(fields: [reviewerId], references: [id])
  scorecardId    String
  scorecard      Scorecard        @relation(fields: [scorecardId], references: [id])
  reviewSource   ReviewSource
  rubricVersion  Int
  status         ReviewStatus
  totalScore     Float
  confidence     Float?
  summary        String
  feedbackComment String       @default("")
  positiveNotes   String       @default("")
  instructionLinks String      @default("")
  feedbackStatus  String      @default("new")
  feedbackAckAt   DateTime?
  feedbackAckBy   String?
  appealStatus    String      @default("none")
  appealDueAt     DateTime?
  appealResolvedAt DateTime?
  criticalError   Boolean     @default(false)
  criticalCategory String?
  needsReanswer   Boolean     @default(false)
  reanswerStatus  String      @default("not_needed")
  calibrationStatus String    @default("none")
  calibrationNotes  String    @default("")
  selfReviewNotes   String    @default("")
  finalizedAt    DateTime?
  scores         CriterionScore[]
  findings       Finding[]
  feedbackEvents ReviewFeedbackEvent[]
  trainingAssignments TrainingAssignment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CriterionScore {
  id                String             @id @default(cuid())
  reviewId          String
  review            Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterionId       String
  criterion         ScorecardCriterion @relation(fields: [criterionId], references: [id])
  value             Int?
  passed            Boolean?
  isNotApplicable   Boolean            @default(false)
  comment           String
  evidenceMessageId String?

  @@unique([reviewId, criterionId])
}

model Finding {
  id              String           @id @default(cuid())
  reviewId        String
  review          Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  ownerType       FindingOwnerType
  category        String
  rootCause       String
  riskLevel       RiskLevel
  evidenceSummary String
  coachingAction  CoachingAction?
  createdAt       DateTime         @default(now())
}

model CoachingAction {
  id        String   @id @default(cuid())
  findingId String   @unique
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignee  String
  action    String
  dueAt     DateTime?
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewQuota {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  assigneeName      String
  supportLine       String?
  periodStart       DateTime
  periodEnd         DateTime
  plannedCount      Int
  dsatTargetPercent Int       @default(30)
  absenceDays       Int       @default(0)
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId, periodStart, periodEnd])
  @@index([workspaceId, assigneeName])
}

model SavedQueueView {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  name        String
  href        String
  scope       String    @default("private")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, userId])
}

model CalibrationSession {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  ownerId     String
  owner       User      @relation("CalibrationOwner", fields: [ownerId], references: [id])
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id])
  name        String
  status      String    @default("draft")
  dueAt       DateTime?
  notes       String    @default("")
  items       CalibrationSessionItem[]
  participants CalibrationParticipant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, status])
}

model CalibrationSessionItem {
  id             String    @id @default(cuid())
  sessionId      String
  session        CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  baselineReviewId String?
  createdAt      DateTime  @default(now())

  @@unique([sessionId, conversationId])
}

model CalibrationParticipant {
  id          String    @id @default(cuid())
  sessionId   String
  session     CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  status      String    @default("assigned")
  completedAt DateTime?
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sessionId, userId])
}

model ReviewFeedbackEvent {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
}

model IntegrationRun {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id])
  actorId       String?
  actor         User?     @relation(fields: [actorId], references: [id])
  source        String
  mode          String
  status        String
  dryRun        Boolean   @default(true)
  requestedLimit Int      @default(100)
  importedCount Int       @default(0)
  errorCount    Int       @default(0)
  errorMessage  String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([workspaceId, startedAt])
  @@index([workspaceId, source])
}

model SamplingRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  type        String
  conditionsJson String @default("{}")
  targetPercent Int    @default(10)
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, isActive])
}

model QualityKnowledgeEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  category    String
  title       String
  description String
  recommendation String
  riskLevel   RiskLevel
  source      String    @default("manual")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, category])
}

model TrainingAssignment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  reviewId    String?
  review      Review?   @relation(fields: [reviewId], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TrainingAssignee", fields: [assigneeId], references: [id])
  assignedById String?
  assignedBy  User?     @relation("TrainingAssignedBy", fields: [assignedById], references: [id])
  assigneeName String
  title       String
  description String
  dueAt       DateTime?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeName])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    String
  createdAt   DateTime  @default(now())
}
