generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  TEAM_LEAD
  QA_ANALYST
  SUPPORT_AGENT
  VIEWER
}

enum QaStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  FINALIZED
  REOPENED
}

enum ConversationChannel {
  CHAT
  EMAIL
  TICKET
  MESSENGER
}

enum ParticipantType {
  CUSTOMER
  HUMAN_AGENT
  AI_AGENT
  SYSTEM
}

enum ReviewSource {
  HUMAN
  AI
  CALIBRATION
  SELF_REVIEW
}

enum ReviewStatus {
  DRAFT
  FINALIZED
}

enum CriterionKind {
  SCALE_1_3
  PASS_FAIL
}

enum FindingOwnerType {
  AGENT
  PROCESS
  PRODUCT
  POLICY
  AI_SYSTEM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IdentityProviderType {
  DEMO
  MICROSOFT_ENTRA_ID
  ACTIVE_DIRECTORY_LDAPS
  OIDC
  SAML
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum UserLifecycleStatus {
  ACTIVE
  SUSPENDED
  DEPROVISIONED
}

enum BackendJobType {
  INTEGRATION_IMPORT
  REPORT_EXPORT
  DIRECTORY_SYNC
  RETENTION_CLEANUP
  WEBHOOK_INGEST
}

enum BackendJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReportSnapshotStatus {
  QUEUED
  READY
  FAILED
}

model Workspace {
  id                        String                     @id @default(cuid())
  name                      String
  brandName                 String?
  brandTagline              String?
  brandLogoUrl              String?
  brandLogoAlt              String?
  brandMark                 String?
  brandPrimaryColor         String                     @default("#3157d5")
  brandAccentColor          String                     @default("#7c97ff")
  uiTheme                   String                     @default("graphite")
  uiDensity                 String                     @default("comfortable")
  uiCorners                 String                     @default("medium")
  uiContrast                String                     @default("standard")
  uiPaletteOverridesJson    String                     @default("{}")
  users                     User[]
  identityProviders         IdentityProvider[]
  identityGroups            IdentityGroup[]
  userIdentityGroups        UserIdentityGroup[]
  groupRoleMappings         GroupRoleMapping[]
  authSessions              AuthSession[]
  ssoRequestStates          SsoRequestState[]
  localCredentials          LocalCredential[]
  backendJobs               BackendJob[]
  idempotencyKeys           IdempotencyKey[]
  reportSnapshots           ReportSnapshot[]
  reviewEvents              ReviewEvent[]
  integrations              Integration[]
  integrationRuns           IntegrationRun[]
  integrationDiagnosticRuns IntegrationDiagnosticRun[]
  integrationRunItems       IntegrationRunItem[]
  webhookEndpoints          WebhookEndpoint[]
  webhookIngestEvents       WebhookIngestEvent[]
  certificationRuns         CertificationRun[]
  certificationEvidence     CertificationEvidence[]
  apiTokens                 ApiToken[]
  conversations             Conversation[]
  scorecards                Scorecard[]
  reviews                   Review[]
  reviewQuotas              ReviewQuota[]
  savedQueueViews           SavedQueueView[]
  calibrationSessions       CalibrationSession[]
  samplingRules             SamplingRule[]
  knowledgeEntries          QualityKnowledgeEntry[]
  trainingAssignments       TrainingAssignment[]
  coachingPins              CoachingPin[]
  locales                   Locale[]
  translationValues         TranslationValue[]
  translationAudits         TranslationAudit[]
  auditLogs                 AuditLog[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model Locale {
  id                String             @id @default(cuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code              String
  name              String
  isDefault         Boolean            @default(false)
  isEnabled         Boolean            @default(true)
  translationValues TranslationValue[]
  translationAudits TranslationAudit[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, isEnabled])
  @@index([workspaceId, isDefault])
}

model TranslationKey {
  id          String             @id @default(cuid())
  namespace   String
  key         String
  defaultText String
  description String?
  ownerArea   String
  values      TranslationValue[]
  audits      TranslationAudit[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([namespace, key])
  @@index([namespace])
  @@index([ownerArea])
}

model TranslationValue {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localeId      String
  locale        Locale         @relation(fields: [localeId], references: [id], onDelete: Cascade)
  keyId         String
  key           TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  draftText     String?
  publishedText String?
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?          @relation("TranslationPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  version       Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, localeId, keyId])
  @@index([workspaceId, localeId])
  @@index([workspaceId, keyId])
  @@index([publishedById])
}

model TranslationAudit {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localeId    String
  locale      Locale         @relation(fields: [localeId], references: [id], onDelete: Cascade)
  keyId       String
  key         TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?          @relation("TranslationAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  beforeText  String?
  afterText   String?
  createdAt   DateTime       @default(now())

  @@index([workspaceId, localeId, keyId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([actorId])
}

model User {
  id                          String                     @id @default(cuid())
  workspaceId                 String
  workspace                   Workspace                  @relation(fields: [workspaceId], references: [id])
  email                       String
  name                        String
  role                        RoleName
  lifecycleStatus             UserLifecycleStatus        @default(ACTIVE)
  supportLine                 String?
  teamName                    String?
  sourceOfTruthProviderId     String?
  sourceOfTruthProvider       IdentityProvider?          @relation("UserSourceOfTruthProvider", fields: [sourceOfTruthProviderId], references: [id], onDelete: SetNull)
  lastDirectorySyncAt         DateTime?
  suspendedAt                 DateTime?
  deprovisionedAt             DateTime?
  externalIdentities          ExternalIdentity[]
  identityGroups              UserIdentityGroup[]
  authSessions                AuthSession[]
  localCredential             LocalCredential?
  createdBackendJobs          BackendJob[]               @relation("BackendJobCreatedBy")
  reportSnapshots             ReportSnapshot[]           @relation("ReportSnapshotCreatedBy")
  reviewEvents                ReviewEvent[]
  certificationRuns           CertificationRun[]         @relation("CertificationRunActor")
  certificationEvidence       CertificationEvidence[]
  reviews                     Review[]
  savedQueueViews             SavedQueueView[]
  ownedCalibrationSessions    CalibrationSession[]       @relation("CalibrationOwner")
  calibrationParticipants     CalibrationParticipant[]
  feedbackEvents              ReviewFeedbackEvent[]
  assignedTrainingAssignments TrainingAssignment[]       @relation("TrainingAssignee")
  createdTrainingAssignments  TrainingAssignment[]       @relation("TrainingAssignedBy")
  integrationRuns             IntegrationRun[]
  integrationDiagnosticRuns   IntegrationDiagnosticRun[]
  coachingPins                CoachingPin[]
  publishedTranslations       TranslationValue[]         @relation("TranslationPublishedBy")
  translationAudits           TranslationAudit[]         @relation("TranslationAuditActor")
  auditLogs                   AuditLog[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@unique([workspaceId, email])
  @@unique([id, workspaceId])
  @@index([workspaceId, role, name])
  @@index([workspaceId, lifecycleStatus])
  @@index([sourceOfTruthProviderId, lifecycleStatus])
}

model LocalCredential {
  id                     String    @id @default(cuid())
  workspaceId            String
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  login                  String
  passwordHash           String
  passwordSalt           String
  keyVersion             String    @default("scrypt-v1")
  lastLoginAt            DateTime?
  failedLoginCount       Int       @default(0)
  failedLoginWindowStart DateTime?
  lastFailedLoginAt      DateTime?
  lockedUntil            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([login])
  @@unique([workspaceId, login])
  @@index([workspaceId])
  @@index([workspaceId, lockedUntil])
}

model IdentityProvider {
  id                    String                  @id @default(cuid())
  workspaceId           String
  workspace             Workspace               @relation(fields: [workspaceId], references: [id])
  type                  IdentityProviderType
  name                  String
  slug                  String
  status                String                  @default("draft")
  issuer                String?
  tenantId              String?
  clientId              String?
  clientSecretRef       String?
  authorizationUrl      String?
  tokenUrl              String?
  jwksUrl               String?
  scopes                String                  @default("openid profile email")
  configJson            String                  @default("{}")
  lastSyncAt            DateTime?
  lastSyncStartedAt     DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  samlEntityId          String?
  samlMetadataUrl       String?
  samlCertificateRef    String?
  ldapsUrl              String?
  ldapsBindDn           String?
  ldapsBindSecretRef    String?
  scimTokenPrefix       String?
  scimTokenHash         String?                 @unique
  sourceOfTruthUsers    User[]                  @relation("UserSourceOfTruthProvider")
  externalIdentities    ExternalIdentity[]
  identityGroups        IdentityGroup[]
  userIdentityGroups    UserIdentityGroup[]
  groupRoleMappings     GroupRoleMapping[]
  authSessions          AuthSession[]
  ssoRequestStates      SsoRequestState[]
  certificationRuns     CertificationRun[]
  certificationEvidence CertificationEvidence[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, status])
}

model ExternalIdentity {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId      String
  provider        IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerSubject String
  externalId      String?
  email           String
  displayName     String?
  rawClaimsJson   String           @default("{}")
  linkedAt        DateTime         @default(now())
  lastLoginAt     DateTime?
  lastSyncAt      DateTime?
  disabledAt      DateTime?

  @@unique([providerId, providerSubject])
  @@unique([providerId, externalId])
  @@index([userId])
  @@index([providerId, email])
  @@index([providerId, lastSyncAt])
}

model IdentityGroup {
  id                String              @id @default(cuid())
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerId        String
  provider          IdentityProvider    @relation(fields: [providerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  externalGroupId   String
  externalGroupName String
  rawAttributesJson String              @default("{}")
  lastSyncAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  members           UserIdentityGroup[]

  @@unique([providerId, externalGroupId])
  @@unique([providerId, externalGroupId, workspaceId])
  @@index([workspaceId, providerId])
  @@index([workspaceId, externalGroupName])
}

model UserIdentityGroup {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  providerId      String
  provider        IdentityProvider @relation(fields: [providerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  externalGroupId String
  group           IdentityGroup?   @relation(fields: [providerId, externalGroupId, workspaceId], references: [providerId, externalGroupId, workspaceId], onDelete: Cascade)
  linkedAt        DateTime         @default(now())
  lastSyncAt      DateTime?

  @@unique([userId, providerId, externalGroupId])
  @@index([workspaceId, providerId, externalGroupId])
  @@index([providerId, externalGroupId])
}

model GroupRoleMapping {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  providerId        String?
  provider          IdentityProvider? @relation(fields: [providerId], references: [id])
  externalGroupId   String
  externalGroupName String
  role              RoleName
  priority          Int               @default(100)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([workspaceId, providerId, externalGroupId, role])
  @@index([workspaceId, isActive])
  @@index([providerId, isActive])
  @@index([workspaceId, providerId, isActive, priority])
}

model AuthSession {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId       String?
  provider         IdentityProvider? @relation(fields: [providerId], references: [id])
  sessionTokenHash String            @unique
  status           AuthSessionStatus @default(ACTIVE)
  ipHash           String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())

  @@index([workspaceId, userId])
  @@index([workspaceId, status, expiresAt])
  @@index([status, expiresAt])
}

model SsoRequestState {
  key         String           @id
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerId  String
  provider    IdentityProvider @relation(fields: [providerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  value       String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([workspaceId, providerId, expiresAt])
  @@index([providerId, consumedAt, expiresAt])
  @@index([expiresAt])
}

model Integration {
  id                    String                     @id @default(cuid())
  workspaceId           String
  workspace             Workspace                  @relation(fields: [workspaceId], references: [id])
  source                String
  displayName           String
  type                  String                     @default("custom_api")
  status                String
  baseUrl               String?
  configJson            String                     @default("{}")
  syncStateJson         String                     @default("{}")
  authMode              String                     @default("token")
  importLimit           Int                        @default(100)
  batchSize             Int                        @default(25)
  dateRangeDays         Int                        @default(30)
  schedule              String?
  syncCursor            String?
  lastSyncedAt          DateTime?
  lastDryRunAt          DateTime?
  lastImportAt          DateTime?
  lastError             String?
  credentials           IntegrationCredential[]
  runs                  IntegrationRun[]
  diagnosticRuns        IntegrationDiagnosticRun[]
  webhookEndpoints      WebhookEndpoint[]
  certificationRuns     CertificationRun[]
  certificationEvidence CertificationEvidence[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([workspaceId, source])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
}

model IntegrationCredential {
  id              String      @id @default(cuid())
  workspaceId     String
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  kind            String      @default("auth_password")
  authMode        String
  encryptedSecret String
  keyVersion      String      @default("local-dev")
  fingerprint     String?
  lastRotatedAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([integrationId, kind])
  @@index([workspaceId])
  @@index([workspaceId, kind])
}

model ApiToken {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  name          String
  tokenPrefix   String
  tokenHash     String         @unique
  scopes        String
  lastUsedAt    DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  expiresAt     DateTime?
  rateLimits    ApiRateLimit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
}

model ApiRateLimit {
  id           String   @id @default(cuid())
  workspaceId  String
  apiTokenId   String
  apiToken     ApiToken @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)
  routeKey     String
  windowStart  DateTime
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([apiTokenId, routeKey, windowStart])
  @@index([workspaceId, windowStart])
}

model Conversation {
  id                  String                   @id @default(cuid())
  workspaceId         String
  workspace           Workspace                @relation(fields: [workspaceId], references: [id])
  externalSource      String
  externalId          String
  externalUrl         String?
  channel             ConversationChannel
  subject             String
  status              String
  tags                String
  customerName        String
  assigneeName        String?
  qaStatus            QaStatus                 @default(QUEUED)
  qaAssigneeId        String?
  qaAssigneeName      String?
  reviewDueAt         DateTime?
  samplingReason      String
  samplingType        String                   @default("RANDOM")
  csatScore           Int?
  csatBucket          String                   @default("NO_SCORE")
  supportLine         String?
  teamName            String?
  riskHint            String?
  openedAt            DateTime
  closedAt            DateTime?
  messages            Message[]
  reviews             Review[]
  coachingPins        CoachingPin[]
  calibrationItems    CalibrationSessionItem[]
  integrationRunItems IntegrationRunItem[]
  webhookIngestEvents WebhookIngestEvent[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([workspaceId, externalSource, externalId])
  @@unique([id, workspaceId])
  @@index([workspaceId, qaStatus])
  @@index([workspaceId, openedAt])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, reviewDueAt])
  @@index([workspaceId, externalSource])
  @@index([workspaceId, assigneeName])
  @@index([workspaceId, qaAssigneeName])
  @@index([workspaceId, samplingType])
  @@index([workspaceId, csatBucket])
  @@index([workspaceId, supportLine])
  @@index([workspaceId, teamName])
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId      String
  participantType ParticipantType
  authorName      String
  body            String
  sentAt          DateTime
  isPrivate       Boolean          @default(false)
  evidenceScores  CriterionScore[] @relation("CriterionScoreEvidenceMessage")
  coachingPins    CoachingPin[]
  createdAt       DateTime         @default(now())

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

// A note pinned to a specific message in a conversation timeline.
// Internal calibration-alignment notes: authored while evaluating in
// calibration mode, visible to QA roles only (never to support agents).
model CoachingPin {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId, workspaceId], references: [id, workspaceId])
  body           String
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId, conversationId])
  @@index([messageId])
}

model Scorecard {
  id                  String               @id @default(cuid())
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id])
  name                String
  version             Int
  isActive            Boolean              @default(true)
  criteria            ScorecardCriterion[]
  reviews             Review[]
  calibrationSessions CalibrationSession[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([workspaceId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId, isActive])
}

model ScorecardCriterion {
  id          String           @id @default(cuid())
  scorecardId String
  scorecard   Scorecard        @relation(fields: [scorecardId], references: [id])
  key         String
  label       String
  block       String           @default("Общее")
  kind        CriterionKind
  weight      Int
  required    Boolean          @default(true)
  order       Int
  scores      CriterionScore[]

  @@unique([scorecardId, key])
  @@unique([scorecardId, order])
}

model Review {
  id                   String                   @id @default(cuid())
  workspaceId          String
  workspace            Workspace                @relation(fields: [workspaceId], references: [id])
  conversationId       String
  conversation         Conversation             @relation(fields: [conversationId, workspaceId], references: [id, workspaceId])
  reviewerId           String
  reviewer             User                     @relation(fields: [reviewerId, workspaceId], references: [id, workspaceId])
  scorecardId          String
  scorecard            Scorecard                @relation(fields: [scorecardId, workspaceId], references: [id, workspaceId])
  reviewSource         ReviewSource
  rubricVersion        Int
  status               ReviewStatus
  totalScore           Float
  confidence           Float?
  summary              String
  feedbackComment      String                   @default("")
  positiveNotes        String                   @default("")
  instructionLinks     String                   @default("")
  feedbackStatus       String                   @default("new")
  feedbackAckAt        DateTime?
  feedbackAckBy        String?
  appealStatus         String                   @default("none")
  appealDueAt          DateTime?
  appealResolvedAt     DateTime?
  criticalError        Boolean                  @default(false)
  criticalCategory     String?
  needsReanswer        Boolean                  @default(false)
  reanswerStatus       String                   @default("not_needed")
  calibrationStatus    String                   @default("none")
  calibrationNotes     String                   @default("")
  selfReviewNotes      String                   @default("")
  finalizedAt          DateTime?
  scores               CriterionScore[]
  findings             Finding[]
  feedbackEvents       ReviewFeedbackEvent[]
  trainingAssignments  TrainingAssignment[]
  calibrationBaselines CalibrationSessionItem[] @relation("CalibrationBaselineReview")
  events               ReviewEvent[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([workspaceId, status, finalizedAt])
  @@index([workspaceId, reviewSource, status, createdAt])
  @@index([workspaceId, reviewerId, createdAt])
  @@index([workspaceId, conversationId])
  @@index([conversationId, createdAt])
  @@index([scorecardId])
}

model ReviewEvent {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  reviewId       String?
  review         Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  conversationId String?
  actorId        String?
  actor          User?     @relation(fields: [actorId], references: [id])
  action         String
  fromStatus     String?
  toStatus       String?
  metadata       String    @default("{}")
  createdAt      DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([reviewId, createdAt])
  @@index([conversationId, createdAt])
}

model CriterionScore {
  id                String             @id @default(cuid())
  reviewId          String
  review            Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterionId       String
  criterion         ScorecardCriterion @relation(fields: [criterionId], references: [id])
  value             Int?
  passed            Boolean?
  isNotApplicable   Boolean            @default(false)
  comment           String
  evidenceMessageId String?
  evidenceMessage   Message?           @relation("CriterionScoreEvidenceMessage", fields: [evidenceMessageId], references: [id], onDelete: SetNull)

  @@unique([reviewId, criterionId])
  @@index([criterionId])
  @@index([evidenceMessageId])
}

model Finding {
  id              String           @id @default(cuid())
  reviewId        String
  review          Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  ownerType       FindingOwnerType
  category        String
  rootCause       String
  riskLevel       RiskLevel
  evidenceSummary String
  coachingAction  CoachingAction?
  createdAt       DateTime         @default(now())

  @@index([reviewId, riskLevel])
  @@index([riskLevel, createdAt])
  @@index([category])
}

model CoachingAction {
  id        String    @id @default(cuid())
  findingId String    @unique
  finding   Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignee  String
  action    String
  dueAt     DateTime?
  status    String    @default("open")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

