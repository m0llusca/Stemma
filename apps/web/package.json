{
  "name": "support-qa-platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live:helpdesk": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/helpdesk-live-smoke.test.ts",
    "test:live:identity": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/identity-live-smoke.test.ts",
    "test:live:phase-d": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/helpdesk-live-smoke.test.ts tests/live/identity-live-smoke.test.ts",
    "db:up": "docker compose -f ../../compose.yaml up -d postgres",
    "db:down": "docker compose -f ../../compose.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "cross-env RUST_LOG=info prisma migrate dev",
    "db:migrate:debug": "cross-env RUST_LOG=debug prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "jobs:run": "tsx src/scripts/run-jobs.ts",
    "test:otrs:live": "tsx src/scripts/otrs-live-smoke.ts"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.100.14",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@ydbjs/auth": "^6.3.0",
    "@ydbjs/core": "^6.3.0",
    "@ydbjs/query": "^6.2.0",
    "@ydbjs/value": "^6.0.7",
    "clsx": "^2.1.1",
    "ldapts": "^8.1.7",
    "lucide-react": "^0.468.0",
    "next": "^16.2.2",
    "pdfkit": "^0.18.0",
    "prisma": "6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.6",
    "zod": "^3.24.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
