{
  "name": "stemma",
  "version": "0.1.0",
  "private": true,
  "description": "Stemma — omnichannel support QA hub (Next.js)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m0llusca/Stemma.git"
  },
  "homepage": "https://github.com/m0llusca/Stemma",
  "bugs": {
    "url": "https://github.com/m0llusca/Stemma/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "cross-env TEST_DATABASE_URL=postgresql://qc_app:qc_app@localhost:55432/qc_app_demo_verify?schema=public DATABASE_URL=postgresql://qc_app:qc_app@localhost:55432/qc_app_demo_verify?schema=public vitest run tests/integration",
    "test:live:helpdesk": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/helpdesk-live-smoke.test.ts",
    "test:live:identity": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/identity-live-smoke.test.ts",
    "test:live:data-source": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/data-source-live-smoke.test.ts",
    "test:live:demo-seed": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/demo-seed-real-mutation.test.ts",
    "test:live:phase-d": "cross-env VITEST_INCLUDE_LIVE=1 vitest run tests/live/helpdesk-live-smoke.test.ts tests/live/identity-live-smoke.test.ts tests/live/data-source-live-smoke.test.ts",
    "db:up": "docker compose -f ../../compose.yaml up -d postgres",
    "db:down": "docker compose -f ../../compose.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "cross-env RUST_LOG=info prisma migrate dev",
    "db:migrate:debug": "cross-env RUST_LOG=debug prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:verify": "tsx prisma/demo-seed-smoke.ts",
    "db:reset": "prisma migrate reset --force",
    "jobs:run": "tsx src/scripts/run-jobs.ts",
    "test:otrs:live": "tsx src/scripts/otrs-live-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@trpc/server": "^11.17.0",
    "@ydbjs/auth": "^6.3.0",
    "@ydbjs/auth-yandex-cloud": "^0.2.0",
    "@ydbjs/core": "^6.3.0",
    "@ydbjs/query": "^6.2.0",
    "@ydbjs/value": "^6.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "ldapts": "^8.1.7",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.18.0",
    "prisma": "6.19.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
